#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"

# beads integration — call bd's public entry point directly (best-effort;
# mirrors bd 1.1.2's own shim timeout/exit-3 contract). bd's own shim in
# .beads/hooks/ is NOT invoked by git while core.hooksPath is .githooks.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-push "$@"
    _bd_exit=$?
  else
    echo "pre-push: beads hook running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT" >&2
    bd hooks run pre-push "$@"
    _bd_exit=$?
  fi
  if [ "$_bd_exit" -eq 124 ] || { [ "$_bd_used_perl" -eq 1 ] && [ "$_bd_exit" -eq 142 ]; }; then
    echo "pre-push: beads hook timed out after ${_bd_timeout}s — continuing without beads" >&2
    _bd_exit=0
  fi
  if [ "$_bd_exit" -eq 3 ]; then
    echo "pre-push: beads database not initialized — skipping" >&2
    _bd_exit=0
  fi
  if [ "$_bd_exit" -ne 0 ]; then exit "$_bd_exit"; fi
fi
